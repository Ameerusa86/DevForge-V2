generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String           @id @default(uuid())
  name               String
  email              String
  emailVerified      Boolean          @default(false)
  image              String?
  role               UserRole         @default(STUDENT)
  status             UserStatus       @default(ACTIVE)
  mustChangePassword Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  sessions           Session[]
  accounts           Account[]
  createdCourses     Course[]         @relation("CreatedCourses")
  instructedCourses  Course[]         @relation("CourseInstructor")
  enrollments        Enrollment[]
  reviews            Review[]
  notifications      Notification[]
  lessonQuestions    LessonQuestion[]
  lessonAnswers      LessonAnswer[]
  quizSubmissions    QuizSubmission[]
  communityPosts     CommunityPost[]
  communityComments  CommunityComment[]
  communityVotes     CommunityPostVote[]
  instructedSessions LiveSession[]
  sessionRegistrations SessionRegistration[]
  conversations      Conversation[]   @relation("UserConversations")
  sentMessages       DirectMessage[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Course {
  id                   String         @id @default(uuid())
  slug                 String         @unique
  title                String
  description          String
  category             String
  level                CourseLevel    @default(BEGINNER)
  tags                 String[]       @default([])
  phases               Json?
  price                Decimal        @default(0)
  durationMinutes      Int?
  imageUrl             String?
  showUnassignedHeader Boolean        @default(true)
  status               CourseStatus   @default(DRAFT)
  publishedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  instructorId String
  instructor   User         @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?        @relation("CreatedCourses", fields: [userId], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]
  modules      Module[]
  lessons      Lesson[]
  reviews      Review[]

  @@index([instructorId])
  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([slug])
  @@map("course")
}

model Module {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  order       Int
  description String?
  phaseId     String?
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
  @@map("module")
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollment")
}

model Lesson {
  id        String           @id @default(uuid())
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId  String?
  module    Module?          @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  title     String
  order     Int
  content   String
  isFree          Boolean          @default(false)
  videoUrl        String?
  durationSeconds Int?
  phaseId         String?
  progress  LessonProgress[]
  questions LessonQuestion[]
  quiz      Quiz?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([courseId])
  @@index([moduleId])
  @@map("lesson")
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  rating    Int // 1-5 stars
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([rating])
  @@map("review")
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model CourseCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?  @default("BookOpen")
  color       String?  @default("text-[#ff6636]")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([isActive])
  @@map("course_category")
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model fileUpload {
  id          String   @id @default(uuid())
  fileName    String
  fileUrl     String
  contentType String
  isImage     Boolean
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  actionUrl String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notification")
}

enum NotificationType {
  USER_REGISTERED
  COURSE_ENROLLED
  COURSE_COMPLETED
  COURSE_PUBLISHED
  COURSE_UPDATED
  REVIEW_POSTED
  MESSAGE_RECEIVED
  SYSTEM_ALERT
  ADMIN_ALERT
  INFO
}

model ContactSettings {
  id                 String   @id @default(uuid())
  email              String   @default("support@devforge.com")
  phone              String   @default("+1 (234) 567-890")
  addressLine1       String   @default("123 Learning Street")
  addressLine2       String   @default("Tech City, TC 12345")
  addressLine3       String   @default("United States")
  businessHoursLine1 String   @default("Monday - Friday")
  businessHoursLine2 String   @default("9:00 AM - 6:00 PM EST")
  responseTime       String   @default("We typically respond within 24 hours during business days. For urgent matters, please call us directly.")
  heroTitle          String   @default("Contact Us")
  heroSubtitle       String   @default("Have questions? We'd love to hear from you. Send us a message and we'll respond as soon as possible.")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("contact_settings")
}

model ContactFaq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([isActive])
  @@map("contact_faq")
}

model SystemStatus {
  id          String      @id @default(uuid())
  status      StatusLevel @default(OPERATIONAL)
  message     String?
  lastChecked DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("system_status")
}

model Service {
  id          String      @id @default(uuid())
  name        String
  description String?
  status      StatusLevel @default(OPERATIONAL)
  order       Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([order])
  @@index([isActive])
  @@map("service")
}

model Incident {
  id               String           @id @default(uuid())
  title            String
  description      String
  status           IncidentStatus   @default(INVESTIGATING)
  severity         StatusLevel      @default(MINOR)
  affectedServices String[]         @default([])
  startedAt        DateTime         @default(now())
  resolvedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  updates          IncidentUpdate[]

  @@index([status])
  @@index([startedAt])
  @@map("incident")
}

model IncidentUpdate {
  id         String         @id @default(uuid())
  incidentId String
  incident   Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  message    String
  status     IncidentStatus
  createdAt  DateTime       @default(now())

  @@index([incidentId])
  @@index([createdAt])
  @@map("incident_update")
}

model MaintenanceWindow {
  id               String            @id @default(uuid())
  title            String
  description      String
  affectedServices String[]          @default([])
  scheduledStart   DateTime
  scheduledEnd     DateTime
  actualStart      DateTime?
  actualEnd        DateTime?
  status           MaintenanceStatus @default(SCHEDULED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([scheduledStart])
  @@index([status])
  @@map("maintenance_window")
}

enum StatusLevel {
  OPERATIONAL
  DEGRADED
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
  MINOR
  MAJOR
  CRITICAL
  MAINTENANCE
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Pricing Models
model PricingPlan {
  id            String           @id @default(uuid())
  name          String
  description   String?
  price         Float
  billingPeriod String // "monthly", "yearly", "one-time"
  currency      String           @default("USD")
  isPopular     Boolean          @default(false)
  isActive      Boolean          @default(true)
  order         Int              @default(0)
  buttonText    String           @default("Get Started")
  buttonLink    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  features      PricingFeature[]

  @@index([isActive])
  @@index([order])
  @@map("pricing_plan")
}

model PricingFeature {
  id        String      @id @default(uuid())
  planId    String
  plan      PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  text      String
  included  Boolean     @default(true)
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([planId])
  @@index([order])
  @@map("pricing_feature")
}

// Lesson Q&A Models
model LessonQuestion {
  id        String         @id @default(uuid())
  lessonId  String
  userId    String
  title     String
  body      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   LessonAnswer[]

  @@index([lessonId])
  @@index([userId])
  @@map("lesson_question")
}

model LessonAnswer {
  id         String         @id @default(uuid())
  questionId String
  userId     String
  body       String
  isAccepted Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  question   LessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([userId])
  @@map("lesson_answer")
}

// Course Audit Event (aligns with course_audit_event table)
model CourseAuditEvent {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  title       String
  description String
  type        String
  actionUrl   String?  @map("action_url")
  occurredAt  DateTime @default(now()) @map("occurred_at")

  @@index([courseId, occurredAt(sort: Desc)], map: "course_audit_event_course_id_occurred_at_idx")
  @@map("course_audit_event")
}

// Platform Settings (Persistent)
model PlatformSetting {
  id        String   @id @default("default")
  settings  Json
  updatedAt DateTime @updatedAt

  @@map("platform_setting")
}

// Quizzes & Knowledge Checks
model Quiz {
  id           String           @id @default(uuid())
  lessonId     String           @unique
  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  passingScore Int              @default(70)
  questions    QuizQuestion[]
  submissions  QuizSubmission[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("quiz")
}

model QuizQuestion {
  id          String       @id @default(uuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question    String
  order       Int          @default(0)
  explanation String?
  options     QuizOption[]

  @@index([quizId])
  @@map("quiz_question")
}

model QuizOption {
  id         String       @id @default(uuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)

  @@index([questionId])
  @@map("quiz_option")
}

model QuizSubmission {
  id        String   @id @default(uuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  passed    Boolean
  answers   Json?
  createdAt DateTime @default(now())

  @@index([quizId])
  @@index([userId])
  @@map("quiz_submission")
}

// Community Forum
model CommunityPost {
  id        String              @id @default(uuid())
  title     String
  content   String
  tag       String              @default("General")
  authorId  String
  author    User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  upvotes   Int                 @default(0)
  views     Int                 @default(0)
  comments  CommunityComment[]
  votes     CommunityPostVote[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([authorId])
  @@index([tag])
  @@index([createdAt])
  @@map("community_post")
}

model CommunityComment {
  id        String        @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId])
  @@index([authorId])
  @@map("community_comment")
}

model CommunityPostVote {
  id        String        @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([postId, userId])
  @@map("community_post_vote")
}

// Live Sessions & Schedule
model LiveSession {
  id              String                @id @default(uuid())
  title           String
  description     String?
  instructorId    String
  instructor      User                  @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  durationMinutes Int                   @default(60)
  category        String                @default("workshop")
  status          String                @default("upcoming")
  maxAttendees    Int                   @default(100)
  streamUrl       String?
  registrations   SessionRegistration[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([scheduledAt])
  @@index([status])
  @@index([instructorId])
  @@map("live_session")
}

model SessionRegistration {
  id           String      @id @default(uuid())
  sessionId    String
  session      LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredAt DateTime    @default(now())

  @@unique([sessionId, userId])
  @@index([userId])
  @@map("session_registration")
}

// Direct Messages & Support Chat
model Conversation {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)
  subject       String?
  lastMessageAt DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  messages      DirectMessage[]

  @@index([userId])
  @@index([lastMessageAt])
  @@map("conversation")
}

model DirectMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderRole     UserRole     @default(STUDENT)
  text           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@map("direct_message")
}
